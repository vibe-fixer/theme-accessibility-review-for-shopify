{% comment %}
  Example section with planted accessibility problems, for trying the review.
  Not from any real theme.
{% endcomment %}
<style>
  .nl-{{ section.id }} { background: #ffffff; }
  .nl-{{ section.id }} .nl-note { color: #b5b5b5; font-size: 14px; }
  .nl-{{ section.id }} a:focus, .nl-{{ section.id }} button:focus { outline: none; }
</style>

<div class="nl-{{ section.id }}">
  {{ section.settings.image | image_url: width: 800 | image_tag }}
  <h2>{{ section.settings.heading }}</h2>
  <p class="nl-note">No spam. Unsubscribe any time.</p>

  {% form 'customer', id: 'nl-form-{{ section.id }}' %}
    <input type="email" name="contact[email]" placeholder="Your email">
    <button type="submit">{% render 'icon-arrow' %}</button>
  {% endform %}

  <div class="nl-close" onclick="this.parentElement.remove()">&times;</div>

  <a href="{{ settings.social_instagram_link }}">{% render 'icon-instagram' %}</a>
  <a href="{{ routes.cart_url }}" tabindex="3"><img src="{{ 'cart.svg' | asset_url }}" alt=""></a>
</div>

{% schema %}
{
  "name": "Newsletter (example)",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Join our list" }
  ]
}
{% endschema %}
